VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Set to true to use local demo mode (no Supabase connection needed)
VITE_BYPASS_AUTH=false

# ---------- Stripe ----------
# Publishable key — exposed to the browser. Must have the VITE_ prefix.
# Get it from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Secret key — SERVER ONLY. Do NOT commit. Set in Vercel → Project → Settings → Environment Variables.
# Get it from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx

# Price ID — SERVER ONLY (no VITE_ prefix). Used by api/create-checkout-session.js.
# Get it from: https://dashboard.stripe.com/products → your product → pricing
STRIPE_PRICE_ID=price_xxx
